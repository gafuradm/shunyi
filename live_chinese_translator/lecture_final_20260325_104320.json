      "translation": null,
      "metadata": {
        "status": 0,
        "is_final": false
      }
    },
    {
      "id": 1,
      "text": "，让革命历史走出书本，走进校园，践行语文学史，以测物理的初心",
      "timestamp": 1774406113.551148,
      "datetime": "2026-03-25 10:35:13",
      "speaker": "teacher",
      "type": "recognition_interim",
