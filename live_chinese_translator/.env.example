# ===== Шаблон переменных окружения для ОБЛАЧНОГО хостинга =====
# Скопируйте значения из вашего локального .env в панель настроек хостинга
# (Railway: Variables / Render: Environment / Fly.io: fly secrets set).

# Обязательно: включить облачный режим (без локального микрофона)
CLOUD_MODE=1

# Ключ DeepSeek (для перевода и ассистента Xiao Shu)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ключи iFLYTEK (Xunfei) — для распознавания речи (используется на Mac,
# но можно указать и здесь для совместимости)
XF_APPID=your_appid
XF_API_KEY=your_api_key
XF_API_SECRET=your_api_secret

# Учётные данные TURN-сервера Metered.ca (для WebRTC-трансляции экрана)
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential
TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp

# Порт (хостинг обычно задаёт PORT автоматически)
PORT=8000
SESSION_SECRET=my_lecture_secret_2026
GEO_SECRET_KEY=your_geo_secret_key

# ===== Архив лекций (прошедшие уроки) =====
# Папка, где облако хранит архив лекций (JSON-файлы)
ARCHIVE_DIR=archive

# Секретный ключ для загрузки/удаления лекций в архив.
# ДОЛЖЕН быть ОДИНАКОВЫМ на облаке и на Mac (для автоматической синхронизации).
ARCHIVE_UPLOAD_KEY=change_me_archive_key

# Публичный URL облака (только на Mac, НЕ в облаке).
# Mac автоматически отправляет лекцию в архив облака при завершении работы.
# Пример: CLOUD_ARCHIVE_URL=https://xxx.up.railway.app
CLOUD_ARCHIVE_URL=
